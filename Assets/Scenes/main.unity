--- !u!114 &397032787
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397032782}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c9c1ad057fcda443a57f1767fbede2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelTestSecim: {fileID: 1909554073}
  panelSoruEkrani: {fileID: 1356700092}
  siklarGrubu: {fileID: 1362456286}
  soruYazisi: {fileID: 1508501749}
  butonResimleri:
  - {fileID: 532491058}
  - {fileID: 776269624}
  - {fileID: 1893375344}
  - {fileID: 200110368}
  butonYazilari:
  - {fileID: 1000929476}
  - {fileID: 1321273963}
  - {fileID: 186895190}
  - {fileID: 1065366709}
  temelSorular:
  - soruMetni: "Ka\u011F\u0131t at\u0131klar hangi renkli geri d\xF6n\xFC\u015F\xFCm
      kutusuna at\u0131lmal\u0131d\u0131r?"
    secenekler:
    - "K\u0131rm\u0131z\u0131"
    - Mavi
    - "Ye\u015Fil"
    - Siyah
    dogruCevapIndex: 1
  - soruMetni: "Geri d\xF6n\xFC\u015F\xFCm ne demektir?"
    secenekler:
    - "At\u0131klar\u0131 denize d\xF6kmek"
    - "Kullan\u0131lm\u0131\u015F malzemeleri yeni \xFCr\xFCnlere d\xF6n\xFC\u015Ft\xFCrmek"
    - "\xC7\xF6pleri yakmak"
    - "At\u0131klar\u0131 g\xF6mmek"
    dogruCevapIndex: 1
  - soruMetni: "A\u015Fa\u011F\u0131dakilerden hangisi geri d\xF6n\xFC\u015Ft\xFCr\xFClebilir
      bir malzemedir?"
    secenekler:
    - Islak mendil
    - "Gazete ka\u011F\u0131d\u0131"
    - "Kullan\u0131lm\u0131\u015F pe\xE7ete"
    - Sigara izmariti
    dogruCevapIndex: 1
  - soruMetni: "\xC7evreye at\u0131lan bir plastik \u015Fi\u015Fe do\u011Fada yakla\u015F\u0131k
      ka\xE7 y\u0131lda \xE7\xF6z\xFCn\xFCr?"
    secenekler:
    - "1-2 y\u0131l"
    - "10 y\u0131l"
    - "50 y\u0131l"
    - "400-500 y\u0131l"
    dogruCevapIndex: 3
  - soruMetni: "A\u015Fa\u011F\u0131dakilerden hangisi geri d\xF6n\xFC\u015F\xFCm\xFCn
      faydalar\u0131ndan biri DE\u011E\u0130LD\u0130R?"
    secenekler:
    - "Enerji tasarrufu sa\u011Flar"
    - "Do\u011Fal kaynaklar\u0131 korur\t"
    - "Hava kirlili\u011Fini art\u0131r\u0131r"
    - "\xC7\xF6p miktar\u0131n\u0131 azalt\u0131r"
    dogruCevapIndex: 2
  - soruMetni: "Hangi renk \xE7\xF6p kutusu plastik at\u0131klar i\xE7in kullan\u0131l\u0131r?"
    secenekler:
    - Mavi
    - "Ye\u015Fil"
    - "Sar\u0131"
    - Siyah
    dogruCevapIndex: 2
  - soruMetni: "Cam bir \u015Fi\u015Feyi nereye atmal\u0131y\u0131z?"
    secenekler:
    - "Normal \xE7\xF6p kutusuna"
    - "Ye\u015Fil renkli cam geri d\xF6n\xFC\u015F\xFCm kutusuna"
    - "Organik at\u0131k kutusuna"
    - Kanalizasyona
    dogruCevapIndex: 1
  - soruMetni: "A\u015Fa\u011F\u0131dakilerden hangisi organik at\u0131k \xF6rne\u011Fidir?"
    secenekler:
    - "Plastik \u015Fi\u015Fe"
    - "Al\xFCminyum kutu"
    - "Ekmek k\u0131r\u0131nt\u0131s\u0131"
    - Cam kavanoz
    dogruCevapIndex: 2
  - soruMetni: "Neden at\u0131klar\u0131 kayna\u011F\u0131nda ay\u0131rmal\u0131y\u0131z?"
    secenekler:
    - "\xC7\xFCnk\xFC \xE7\xF6p\xE7\xFCler istemektedir"
    - "Geri d\xF6n\xFC\u015F\xFCm s\xFCrecini kolayla\u015Ft\u0131rmak ve verimlili\u011Fi
      art\u0131rmak i\xE7in"
    - "\xC7\xFCnk\xFC yasalar bunu yasaklamaktad\u0131r"
    - "Koku olu\u015Fturmamas\u0131 i\xE7in"
    dogruCevapIndex: 1
  - soruMetni: "Bir \xE7ocuk kullan\u0131lm\u0131\u015F ka\u011F\u0131d\u0131n arka
      y\xFCz\xFCne resim yap\u0131yor. Bu davran\u0131\u015F a\u015Fa\u011F\u0131dakilerden
      hangisidir?"
    secenekler:
    - "Geri d\xF6n\xFC\u015F\xFCm (Recycle)"
    - "Yeniden kullan\u0131m (Reuse)"
    - Azaltma (Reduce)
    - Bertaraf
    dogruCevapIndex: 1
  ortaSorular:
  - soruMetni: "Hangi renk \xE7\xF6p kutusu ka\u011F\u0131t ve karton at\u0131klar
      i\xE7in kullan\u0131l\u0131r?"
    secenekler:
    - Mavi
    - "Sar\u0131"
    - "Ye\u015Fil"
    - "K\u0131rm\u0131z\u0131"
    dogruCevapIndex: 0
  - soruMetni: "Plastik \u015Fi\u015Felerin \xFCzerindeki hangi sembol geri d\xF6n\xFC\u015Ft\xFCr\xFClebilir
      oldu\u011Funu g\xF6sterir?"
    secenekler:
    - "\xDC\xE7gen i\xE7inde ok i\u015Fareti"
    - "Kalp sembol\xFC"
    - "Y\u0131ld\u0131z i\u015Fareti"
    - "Art\u0131 i\u015Fareti"
    dogruCevapIndex: 0
  - soruMetni: Kompostlama nedir?
    secenekler:
    - "Plastiklerin yak\u0131lmas\u0131"
    - "Organik at\u0131klar\u0131n do\u011Fal ayr\u0131\u015Fmayla g\xFCbreye d\xF6n\xFC\u015Ft\xFCr\xFClmesi"
    - "Cam\u0131n eritilip yeniden kullan\u0131lmas\u0131"
    - "Metal at\u0131klar\u0131n depolanmas\u0131"
    dogruCevapIndex: 1
  - soruMetni: "A\u015Fa\u011F\u0131dakilerden hangisi organik (biyolojik) at\u0131k
      s\u0131n\u0131f\u0131na girer?"
    secenekler:
    - "Cam \u015Fi\u015Fe"
    - "Meyve kabu\u011Fu"
    - "Plastik po\u015Fet"
    - Pil
    dogruCevapIndex: 1
  - soruMetni: "A\u015Fa\u011F\u0131dakilerden hangisi 'yeniden kullan\u0131m' (reuse)
      \xF6rne\u011Fidir?"
    secenekler:
    - "Cam \u015Fi\u015Feyi cam fabrikas\u0131na g\xF6ndermek"
    - "Eski bir kavanozun kalemlik olarak kullan\u0131lmas\u0131"
    - "Ka\u011F\u0131d\u0131 ka\u011F\u0131t fabrikas\u0131nda eritmek"
    - "Plastik \u015Fi\u015Feyi \xE7\xF6pe atmak\t"
    dogruCevapIndex: 1
  - soruMetni: "Geri d\xF6n\xFC\u015F\xFCm\xFCn en \xF6nemli \xE7evresel faydas\u0131
      nedir?\t"
    secenekler:
    - "Enerji t\xFCketimini art\u0131r\u0131r"
    - "Do\u011Fal kaynaklar\u0131n korunmas\u0131na yard\u0131mc\u0131 olur"
    - "At\u0131k miktar\u0131n\u0131 art\u0131r\u0131r\t"
    - "Hava kirlili\u011Fini art\u0131r\u0131r"
    dogruCevapIndex: 1
  - soruMetni: "Hangi malzeme sonsuz kez geri d\xF6n\xFC\u015Ft\xFCr\xFClebilir?"
    secenekler:
    - ' Plastik'
    - "Ka\u011F\u0131t"
    - Cam
    - Tekstil
    dogruCevapIndex: 2
  - soruMetni: " Piller neden ayr\u0131 toplanmal\u0131d\u0131r?"
    secenekler:
    - "Renkleri g\xFCzel oldu\u011Fu i\xE7in"
    - "\u0130\xE7erdikleri a\u011F\u0131r metaller \xE7evreye zarar verdi\u011Fi
      i\xE7in"
    - "\xC7ok hafif olduklar\u0131 i\xE7in"
    - "Geri d\xF6n\xFC\u015F\xFCm\xFC olmad\u0131\u011F\u0131 i\xE7in"
    dogruCevapIndex: 1
  - soruMetni: "Geri d\xF6n\xFC\u015Ft\xFCr\xFClm\xFC\u015F 1 ton ka\u011F\u0131t
      ka\xE7 a\u011Fac\u0131 kurtar\u0131r?"
    secenekler:
    - "2-3 a\u011Fa\xE7"
    - "10-17 a\u011Fa\xE7"
    - "50 a\u011Fa\xE7"
    - "100 a\u011Fa\xE7"
    dogruCevapIndex: 1
  - soruMetni: "Elektronik at\u0131klar (e-at\u0131k) neden \xF6zel at\u0131k olarak
      s\u0131n\u0131fland\u0131r\u0131l\u0131r?"
    secenekler:
    - "\xC7ok b\xFCy\xFCk olduklar\u0131 i\xE7in"
    - "Tehlikeli kimyasallar ve de\u011Ferli metaller i\xE7erdikleri i\xE7in"
    - "Sadece pahal\u0131 olduklar\u0131 i\xE7in"
    - Renkleri nedeniyle
    dogruCevapIndex: 1
  ileriSorular:
  - soruMetni: "Plastik t\xFCrlerini numaraland\u0131ran 'Re\xE7ine Tan\u0131mlama
      Kodu' sistemi (1-7) neyi ifade eder?"
    secenekler:
    - "Plasti\u011Fin polimer bile\u015Fimini ve geri d\xF6n\xFC\u015F\xFCm uygunlu\u011Funu"
    - "Plasti\u011Fin kalite s\u0131n\u0131f\u0131n\u0131"
    - "Plasti\u011Fin \xFCretim y\u0131l\u0131n\u0131"
    - "Plasti\u011Fin a\u011F\u0131rl\u0131\u011F\u0131n\u0131"
    dogruCevapIndex: 0
  - soruMetni: "'D\xF6ng\xFCsel Ekonomi' modelinde at\u0131\u011F\u0131n rol\xFC
      nedir?"
    secenekler:
    - "At\u0131k depolanarak ekonomiden \xE7\u0131kar\u0131l\u0131r"
    - "At\u0131k yak\u0131larak enerji \xFCretilir ve ekonomiye katk\u0131s\u0131
      sona erer"
    - "At\u0131k, yeni \xFCretim s\xFCre\xE7leri i\xE7in kaynak olarak sisteme geri
      d\xF6ner"
    - "At\u0131k ihra\xE7 edilerek ekonomik de\u011Fer yarat\u0131l\u0131r"
    dogruCevapIndex: 2
  - soruMetni: "Kimyasal geri d\xF6n\xFC\u015F\xFCm (chemical recycling) mekanik
      geri d\xF6n\xFC\u015F\xFCmden nas\u0131l ayr\u0131l\u0131r?"
    secenekler:
    - "Kimyasal geri d\xF6n\xFC\u015F\xFCm sadece cam i\xE7in kullan\u0131l\u0131r"
    - "Mekanik geri d\xF6n\xFC\u015F\xFCm daha az enerji t\xFCketir ve daha yayg\u0131nd\u0131r,
      kimyasal y\xF6ntemde fark yoktur"
    - "Kimyasal geri d\xF6n\xFC\u015F\xFCm yaln\u0131zca metallere uygulanabilir"
    - "Kimyasal geri d\xF6n\xFC\u015F\xFCm, polimerleri monomer veya ham maddeye
      ay\u0131r\u0131rken mekanik y\xF6ntem fiziksel \u015Fekil de\u011Fi\u015Ftirir"
    dogruCevapIndex: 3
  - soruMetni: "Geri d\xF6n\xFC\u015F\xFCm hiyerar\u015Fisinde (R hiyerar\u015Fisi)
      \xF6ncelik s\u0131ras\u0131 nas\u0131ld\u0131r?"
    secenekler:
    - "Geri d\xF6n\xFC\u015F\xFCm \u2192 Yeniden kullan\u0131m \u2192 Azaltma \u2192
      Bertaraf"
    - "Azaltma (Reduce) \u2192 Yeniden kullan\u0131m (Reuse) \u2192 Geri d\xF6n\xFC\u015F\xFCm
      (Recycle) \u2192 Bertaraf"
    - "Bertaraf \u2192 Geri d\xF6n\xFC\u015F\xFCm \u2192 Azaltma \u2192 Yeniden kullan\u0131m"
    - "T\xFCm ad\u0131mlar e\u015Fit \xF6neme sahiptir"
    dogruCevapIndex: 1
  - soruMetni: " LCA (Ya\u015Fam D\xF6ng\xFCs\xFC De\u011Ferlendirmesi) geri d\xF6n\xFC\u015F\xFCm
      ba\u011Flam\u0131nda ne anlama gelir?"
    secenekler:
    - "Bir \xFCr\xFCn\xFCn ham madde \xE7\u0131kar\u0131m\u0131ndan bertarafa kadar
      t\xFCm \xE7evresel etkisinin analizi"
    - "Bir \xFCr\xFCn\xFCn ham madde \xE7\u0131kar\u0131m\u0131ndan bertarafa kadar
      t\xFCm \xE7evresel etkisinin analizi"
    - "Geri d\xF6n\xFC\u015F\xFCm tesislerinin verimlilik analizi"
    - "At\u0131klar\u0131n yasal \xF6mr\xFCn\xFCn hesaplanmas\u0131"
    dogruCevapIndex: 0
  - soruMetni: " 'Downcycling' (a\u015Fa\u011F\u0131 d\xF6n\xFC\u015F\xFCm) ne anlama
      gelir?"
    secenekler:
    - "Malzemenin orijinalinden daha y\xFCksek kalitede geri d\xF6n\xFC\u015Ft\xFCr\xFClmesi"
    - "At\u0131klar\u0131n denizlere g\xF6nderilmesi"
    - "Malzemenin her geri d\xF6n\xFC\u015F\xFCm d\xF6ng\xFCs\xFCnde kalite kaybederek
      daha d\xFC\u015F\xFCk kaliteli \xFCr\xFCnlere d\xF6n\xFC\u015Ft\xFCr\xFClmesi"
    - "Malzemenin enerji geri kazan\u0131m\u0131 amac\u0131yla yak\u0131lmas\u0131"
    dogruCevapIndex: 2
  - soruMetni: "T\xFCrkiye'de 2019 y\u0131l\u0131nda y\xFCr\xFCrl\xFC\u011Fe giren
      'S\u0131f\u0131r At\u0131k Y\xF6netmeli\u011Fi'nin temel amac\u0131 nedir?"
    secenekler:
    - "T\xFCm at\u0131klar\u0131n yak\u0131larak enerji \xFCretilmesi"
    - "At\u0131k olu\u015Fumunun \xF6nlenmesi, kaynakta ayr\u0131\u015Ft\u0131rma
      ve geri d\xF6n\xFC\u015F\xFCm\xFCn yayg\u0131nla\u015Ft\u0131r\u0131lmas\u0131"
    - "Sadece cam at\u0131klar\u0131n toplanmas\u0131"
    - "At\u0131klar\u0131n yurt d\u0131\u015F\u0131na ihracat\u0131n\u0131n d\xFCzenlenmesi"
    dogruCevapIndex: 1
  - soruMetni: "Geri d\xF6n\xFC\u015Ft\xFCr\xFClm\xFC\u015F al\xFCminyum \xFCretimi,
      birincil al\xFCminyum \xFCretimine k\u0131yasla ne kadar enerji tasarrufu sa\u011Flar?"
    secenekler:
    - '%5-10'
    - '%25-30'
    - '%50-60'
    - '%90-95'
    dogruCevapIndex: 3
  - soruMetni: "'Geni\u015Fletilmi\u015F \xDCretici Sorumlulu\u011Fu (G\xDCS/EPR)'
      ilkesi neyi \xF6ng\xF6r\xFCr?"
    secenekler:
    - "Devletin t\xFCm geri d\xF6n\xFC\u015F\xFCm maliyetlerini kar\u015F\u0131lamas\u0131"
    - "\xDCreticilerin \xFCr\xFCnlerinin t\xFCketim sonras\u0131 at\u0131k y\xF6netiminden
      de sorumlu tutulmas\u0131"
    - "T\xFCketicilerin geri d\xF6n\xFC\u015F\xFCm maliyetlerini tek ba\u015F\u0131na
      \xFCstlenmesi"
    - "Belediyeler taraf\u0131ndan geri d\xF6n\xFC\u015F\xFCm vergisi al\u0131nmas\u0131"
    dogruCevapIndex: 1
  - soruMetni: "Belediyeler taraf\u0131ndan geri d\xF6n\xFC\u015F\xFCm vergisi al\u0131nmas\u0131"
    secenekler:
    - "Plastik geri d\xF6n\xFC\u015F\xFCm\xFC mikroplastik \xFCretmez"
    - "Plastiklerin mekanik geri d\xF6n\xFC\u015F\xFCm\xFC ve y\u0131kanmas\u0131
      s\xFCrecinde mikroplastikler a\xE7\u0131\u011Fa \xE7\u0131kabilir"
    - "Mikroplastikler yaln\u0131zca denizlerdeki plastiklerden kaynaklan\u0131r"
    - " Geri d\xF6n\xFC\u015F\xFCm, mikroplastik sorununu tamamen \xE7\xF6zer"
    dogruCevapIndex: 1
  sureYazisi: {fileID: 758172577}
